/* =====================================================
   PAGE TITLE
===================================================== */

function adminTitle(page) {
  const titles = {
    dashboard: "Dashboard",
    users: "Users",
    deposits: "Deposits",
    withdrawals: "Withdrawals",
    rewards: "Referral Rewards",
    transactions: "Transactions",
    support: "Support",
  };

  return (
    titles[page] ||
    "Dashboard"
  );
}

export default App;